DATABASE_URL=postgres://divulga:divulga@localhost:5432/divulga_links
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Porta do painel web (npm run ui)
PORTA_UI=3400

# Mercado Livre Developers (developers.mercadolivre.com.br/pt_br/aplicacoes)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Precisa ser HTTPS, um domínio "de verdade" (o ML rejeita https://localhost/...)
# e bater exatamente com o registrado na aplicação. Sem servidor público ainda?
# gere um link em https://webhook.site e use-o aqui — ele mostra o ?code=...
# recebido no próprio dashboard, sem precisar responder nada.
MELI_REDIRECT_URI=
MELI_SITE_ID=MLB

# Bot do Telegram (token via @BotFather).
TELEGRAM_BOT_TOKEN=

# Ollama local (https://ollama.com) pra gerar a "chamada" (frase de efeito) de cada produto.
# Rode `ollama pull qwen2.5:3b` (ou o modelo que preferir) antes de usar.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b

# Nichos ativos, desconto mínimo e canais de destino agora são configurados
# pelo painel web (npm run ui), guardados no banco — não ficam mais no .env.

# Evolution API (self-hosted via docker compose, ver docker-compose.yml) — envio pro WhatsApp.
# EVOLUTION_API_KEY precisa ser o mesmo valor usado no AUTHENTICATION_API_KEY do container
# evolution-api no docker-compose.yml (gere uma string aleatória, ex.: `openssl rand -hex 16`).
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=divulga-links

# Monitor de grupos de terceiros no Telegram (MTProto/GramJS, conta pessoal —
# não é o bot acima). Credenciais de app em https://my.telegram.org, logando
# com o número que vai monitorar o grupo ("API development tools", cria um
# app qualquer). A sessão autenticada em si fica salva no Postgres (aba
# Status do painel → "Conectar"), não aqui.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# API oficial de afiliados da Shopee (GraphQL, affiliate.shopee.com.br) —
# gera link de afiliado e busca ofertas (productOfferV2). Credenciais vêm da
# aprovação do programa de afiliados da Shopee.
SHOPEE_APP_ID=
SHOPEE_SECRET=
